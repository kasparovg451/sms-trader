{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: собрать текущий файл (MSVC)",
            "type": "process",
            "command": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/d",
                "/c",
                "${workspaceFolder}\\scripts\\build-active-file.bat",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Собирает открытый C++-файл с предупреждениями уровня /W4."
        }
    ]
}
